{
	"name": "@nlib/lint-commit",
	"publishConfig": {
		"access": "public"
	},
	"version": "2.0.0",
	"license": "Apache-2.0",
	"author": {
		"name": "Kei Ito",
		"email": "kei.itof@gmail.com",
		"url": "https://gojabako.zone"
	},
	"homepage": "https://github.com/nlibjs/lint-commit",
	"repository": "https://github.com/nlibjs/lint-commit",
	"engines": {
		"node": ">=22.12.0"
	},
	"type": "module",
	"main": "./lib/cli.mjs",
	"files": [
		"lib",
		"!**/*.test.*",
		"!**/*.map"
	],
	"bin": {
		"lint-commit": "./lib/cli.mjs",
		"nlib-lint-commit": "./lib/cli.mjs"
	},
	"scripts": {
		"build": "tsc",
		"test": "run-s build test:*",
		"test:unit": "ava",
		"lint": "biome check",
		"version": "changelog --output CHANGELOG.md && git add CHANGELOG.md"
	},
	"dependencies": {
		"commander": "15.0.0",
		"semver": "7.8.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@nlib/changelog": "0.4.2",
		"@types/node": "26.6.5",
		"@types/semver": "7.8.0",
		"ava": "8.1.1",
		"npm-run-all": "4.1.5",
		"typescript": "7.0.2"
	},
	"ava": {
		"files": [
			"lib/**/*.test.*(m|c)+(j|t)s*(x)"
		]
	},
	"renovate": {
		"extends": [
			"github>nlibjs/renovate-config"
		]
	}
}
